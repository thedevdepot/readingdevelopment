{
  "$schema": "https://aka.ms/azure-static-web-apps-database-config-schema",
  "data-source": {
    "database-type": "cosmosdb_nosql",
    "options": {
      "database": "quizdatabase",
      "schema": "./staticwebapp.database.schema.gql"
    }
  },
  "runtime": {
    "graphql": {
      "enabled": true,
      "path": "/graphql"
    }
  },
  "entities": {
    "UserProfile": {
      "source": {
        "type": "container",
        "object": "Users",
        "partitionKeyPath": "/email"
      },
      "permissions": [
        {
          "role": "authenticated",
          "actions": [
            {
              "action": "read",
              "policy": "@item.email eq @claims.email"
            },
            {
              "action": "create",
              "policy": "@item.email eq @claims.email"
            },
            {
              "action": "update",
              "policy": "@item.email eq @claims.email"
            },
            {
              "action": "delete",
              "policy": "@item.email eq @claims.email"
            }
          ]
        }
      ]
    }
  }
}
