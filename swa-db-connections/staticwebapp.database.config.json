{
  "$schema": "https://aka.ms/azure-static-web-apps-database-config-schema",
  "data-source": {
    "database-type": "cosmosdb_nosql",
    "connection-string": "@env('COSMOSDB_CONNECTION_STRING')",
    "options": {
      "database": "quizdatabase",
      "schema": "./staticwebapp.database.schema.gql"
    }
  },
  "runtime": {
    "graphql": {
      "enabled": true,
      "path": "/graphql"
    }
  },
  "entities": {
    "UserProfile": {
      "source": {
        "type": "container",
        "object": "Users",
        "partitionKeyPath": "/email"
      },
      "permissions": [
        {
          "role": "authenticated",
          "actions": ["read", "create", "update", "delete"]
        }
      ]
    }
  }
}
